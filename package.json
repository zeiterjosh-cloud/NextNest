{
  "name": "nextnest",
  "version": "0.1.0",
  "description": "Behavioral real estate intelligence platform",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "agent-portal"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:agent\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:agent": "cd agent-portal && npm run dev",
    "build": "npm run build:backend && npm run build:frontend && npm run build:agent",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "build:agent": "cd agent-portal && npm run build",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && npm test"
  },
  "devDependencies": {
    "concurrently": "^8.0.0"
  }
}
